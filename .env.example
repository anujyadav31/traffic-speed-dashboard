# Copy to .env and adjust. Every value has a sensible default (see app/core/config.py).

# SQLite database file (default: traffic.db in the project folder)
# DATABASE_URL=sqlite:///./traffic.db

# Redis for Celery
REDIS_URL=redis://localhost:6379/0

# celery = jobs run on a Celery worker (needs Redis + `make worker`)
# thread = jobs run inside the API process (no Redis needed; good for quick tries)
JOB_EXECUTOR=celery

# Where videos and the model are read from (read-only). Defaults to the sibling
# "Vehicle detection and speed estimation" folder.
# VIDEOS_DIR=../Vehicle detection and speed estimation
# MODEL_PATH=../Vehicle detection and speed estimation/best_xl_ITD_v1.2.pt

# Where each run's outputs (annotated video, Excel, CSV) are written
# RUNS_DIR=./runs

# Used by the Streamlit dashboard
API_URL=http://localhost:8000
